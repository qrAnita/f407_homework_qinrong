# Utility command for rebuild_cache

build CMakeFiles/rebuild_cache.util: CUSTOM_COMMAND
  COMMAND = C:\Windows\system32\cmd.exe /C "cd /D D:\pnx\C_broad2\build\Debug && D:\pnx\pnx\cmake\cmake-3.31.12-windows-x86_64\cmake-3.31.12-windows-x86_64\bin\cmake.exe --regenerate-during-build -SD:\pnx\C_broad2 -BD:\pnx\C_broad2\build\Debug"
  DESC = Running CMake to regenerate build system...
  pool = console
  restat = 1

build rebuild_cache: phony CMakeFiles/rebuild_cache.util

# =============================================================================
# Write statements declared in CMakeLists.txt:
# D:/pnx/C_broad2/CMakeLists.txt
# =============================================================================

# =============================================================================
# Object build statements for OBJECT_LIBRARY target STM32_Drivers


